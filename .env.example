# TreePulse landing page — environment variables
# Copy to `.env.local` for local development. All values are optional; the page
# renders a safe "coming soon" state when the APK URL is absent.

# Absolute URL of the latest Android APK. The CI workflow in
# TreePulse-App/.github/workflows/deploy.yml publishes it as a GitHub Release
# asset named `treepulse-latest.apk`, so the stable URL is:
#   https://github.com/Cyizere-Happy/TreePulse-App/releases/latest/download/treepulse-latest.apk
NEXT_PUBLIC_ANDROID_APK_URL=

# Optional APK metadata shown next to the download button.
# Leave blank to hide a row. VERSION falls back to the mobile app's app.json value (1.0.0).
NEXT_PUBLIC_APK_VERSION=
NEXT_PUBLIC_APK_SIZE=
NEXT_PUBLIC_APK_UPDATED=

# Public site origin, used for canonical + Open Graph URLs.
NEXT_PUBLIC_SITE_URL=
