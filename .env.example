# CropSuite landing page — environment variables (names only, no values here).
# Copy to `.env.local` for local development.

# Stable public URL of the latest CropSuite Android APK (leave empty until one exists).
# Passed to the Docker build as the NEXT_PUBLIC_ANDROID_APK_URL build arg.
# When empty, the download button shows a disabled "Coming soon" state
# (it never links to "#" or a fake file).
NEXT_PUBLIC_ANDROID_APK_URL=

# Optional APK metadata shown beside the download button (leave blank to hide).
NEXT_PUBLIC_APK_VERSION=
NEXT_PUBLIC_APK_SIZE=
NEXT_PUBLIC_APK_UPDATED=

# Public site origin, used for canonical + Open Graph URLs.
NEXT_PUBLIC_SITE_URL=
